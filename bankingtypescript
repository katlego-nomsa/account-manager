// ==========================================
// BANKING SYSTEM - TYPESCRIPT
// ==========================================


// ==========================================
// INTERFACES
// ==========================================

interface Transaction {
    type: string;
    amount: number;
    dateTime: Date;
    status: string;
    reason: string | null;
}

interface Account {
    accountNumber: string;
    name: string;
    surname: string;
    email: string;
    phoneNumber: string;
    idNumber: string;
    pin: string;
    balance: number;
    transactions: Transaction[];
}


